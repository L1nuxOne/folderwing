#include <windows.h>
#include "brand.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
FW_ICON_ID ICON "../docs/branding/folderwing.ico"
1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Folderwing - File manager for Windows and WSL\0"
   VALUE "FileVersion", FW_VERSION "\0"
   VALUE "InternalName", "Folderwing\0"
   VALUE "OriginalFilename", "folderwing.exe\0"
   VALUE "ProductName", FW_NAME "\0"
   VALUE "ProductVersion", FW_VERSION "\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 OpenPilot contributors\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
